# Copy to .env and fill in. .env is gitignored — never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults live in harness/main.py)
# MYHARNESS_MODEL=claude-opus-5
# MYHARNESS_MAX_TOKENS=16000
# MYHARNESS_COMPACT_AT=150000       # summarize old turns past this prompt size; 0 = off
# MYHARNESS_MEMORY_DB=~/.myharness/memory.db   # long-term notes, shared by all projects
# MYHARNESS_SUBAGENT_MODEL=claude-haiku-5-5     # model for delegated tasks; default: same as main
# MYHARNESS_SANDBOX=0                           # run bash outside the macOS sandbox (not recommended)

# Local model instead of the Anthropic API (needs `ollama serve` running):
# ANTHROPIC_API_KEY=ollama          # dummy — main.py only checks it exists
# ANTHROPIC_BASE_URL=http://localhost:11434
# MYHARNESS_MODEL=qwen3:8b
